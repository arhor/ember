{
  "name": "@arhor/ember",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.8.1 <27"
  },
  "bin": {
    "ember": "bin/ember.ts"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json && npm run test:types && node scripts/docs-discovery.mjs check",
    "test": "node --test \"src/**/*.test.ts\" \"tests/*.test.ts\"",
    "test:docs": "node --test \"tests/docs-discovery*.test.ts\"",
    "test:types": "tsd --typings src/core/model.ts --files \"src/**/*.test-d.ts\"",
    "smoke:codex": "node scripts/live-codex-smoke.ts",
    "smoke:cursor": "node scripts/live-cursor-smoke.ts",
    "smoke:specialist:live": "EMBER_RUN_LIVE_SPECIALIST=1 node scripts/live-codex-specialist.ts",
    "eval:continuity": "node scripts/run-longitudinal-scenario.ts",
    "eval:memory-context": "node scripts/run-longitudinal-scenario.ts --scenario test-fixtures/longitudinal/memory-context-pressure.json",
    "eval:currentness": "node scripts/run-longitudinal-scenario.ts --scenario test-fixtures/longitudinal/currentness-pressure.json",
    "eval:continuity:live": "EMBER_RUN_LIVE_LONGITUDINAL=1 node scripts/run-longitudinal-scenario.ts --provider codex",
    "eval:continuity:process-restart:live": "EMBER_RUN_LIVE_PROCESS_RESTART=1 node scripts/run-process-restart-scenario.ts"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "tsd": "0.33.0",
    "typescript": "7.0.2"
  }
}
