{
  "name": "@arhor/ember",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "ember": "bin/ember.ts"
  },
  "type": "module",
  "scripts": {
    "check": "npm run fmt:check && npm run lint && tsc -p tsconfig.json && npm run test:types && node scripts/docs-discovery.mjs check",
    "test": "node --test \"src/**/*.test.ts\" \"tests/*.test.ts\"",
    "test:docs": "node --test \"tests/docs-discovery*.test.ts\"",
    "test:types": "tsd --typings src/core/model.ts --files \"src/**/*.test-d.ts\"",
    "runtime:episodic": "node bin/ember-runtime.ts",
    "smoke:codex": "node tests/live/codex-smoke.ts",
    "smoke:cursor": "node tests/live/cursor-smoke.ts",
    "smoke:specialist:live": "EMBER_RUN_LIVE_SPECIALIST=1 node tests/live/codex-specialist.ts",
    "smoke:runtime:live": "EMBER_RUN_LIVE_EPISODIC=1 node tests/live/episodic-runtime-smoke.ts",
    "eval:runtime-resource": "node eval/runtime-resource/run.ts",
    "eval:runtime-resource:constrained": "node eval/runtime-resource/constrained-host.ts",
    "eval:continuity": "node eval/longitudinal/run.ts",
    "eval:memory-context": "node eval/longitudinal/run.ts --scenario eval/longitudinal/fixtures/memory-context-pressure.json",
    "eval:currentness": "node eval/longitudinal/run.ts --scenario eval/longitudinal/fixtures/currentness-pressure.json",
    "eval:provenance": "node eval/longitudinal/run.ts --scenario eval/longitudinal/fixtures/provenance-pressure.json",
    "eval:degraded-context": "node eval/longitudinal/run.ts --scenario eval/longitudinal/fixtures/degraded-context-pressure.json",
    "eval:endogenous": "node eval/endogenous/run.ts",
    "eval:endogenous:baseline": "node eval/endogenous/run.ts --attention-control disabled",
    "eval:continuity:live": "EMBER_RUN_LIVE_LONGITUDINAL=1 node eval/longitudinal/run.ts --provider codex",
    "eval:continuity:process-restart:live": "EMBER_RUN_LIVE_PROCESS_RESTART=1 node eval/process-restart/run.ts",
    "eval:endogenous:live": "EMBER_RUN_LIVE_ENDOGENOUS_EVAL=1 node eval/endogenous/run.ts --provider codex",
    "eval:endogenous:restart:live": "EMBER_RUN_LIVE_ENDOGENOUS_RESTART=1 node eval/endogenous-restart/run.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt && git diff --exit-code",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "tsd": "0.33.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26.8.1 <27"
  }
}
